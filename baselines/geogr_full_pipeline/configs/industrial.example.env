# 代码仓库根目录。可以留空，由一键脚本根据自身位置自动推导。
REPO_ROOT=

# 必须指向已完成 TAP-SID 工业实验使用的同一个共享预处理目录。
PROCESSED_ROOT=/path/to/workspace/tap_sid_processed
# GeoGR full 必须使用独立的新输出目录。
RUN_ROOT=/path/to/workspace/geogr_full_run
REUSE_PREPROCESSED=1

# 与已完成的 TAP-SID 工业实验一致：训练/测试两段切分，不单独使用验证集。
NO_VALIDATION=1
DATASET=Industrial

# 使用与 TAP-SID 和 Residual SID 相同的 Llama-3-8B-Instruct。
BASE_MODEL=/path/to/Meta-Llama-3-8B-Instruct

# GeoGR 三层 RQ/EM 标识设置。
CODEBOOK_SIZE=64
P2P_BATCH_SIZE=4
P2P_GRAD_ACCUM=2
P2P_EPOCHS=3
P2P_MAX_PAIRS_PER_POI=50
EM_ITERATIONS=2
EM_EPOCHS=2
EM_BEAMS=20
CPT_EPOCHS=2
CPT_GRAD_ACCUM=4

# 沿用工业 TAP 的四卡训练；对方可以按实际资源修改 GPU 列表。
GPUS=0,1,2,3
SFT_EPOCHS=3
SFT_GRAD_ACCUM=4
LEARNING_RATE=1e-5
SEED=42
KEEP_LAST_K_TRAIN=5

# 正式推荐评估与 TAP-SID 一致，使用 beam-10 和 Top-10。
TEST_BEAMS=10

# 默认立即运行，不强制等待 GPU 全部空闲；如需等待可设为 1。
WAIT_FOR_GPUS=0
WAIT_SECONDS=10
GPU_MEMORY_THRESHOLD_MIB=300
GPU_UTIL_THRESHOLD=5

# Spark 只读取 TAP 已生成的目录、映射和序列，不重新扫描原始行为日志。
SPARK_SUBMIT_BIN=spark-submit
SPARK_MASTER=yarn
SPARK_DRIVER_MEMORY=16g
SPARK_SHUFFLE_PARTITIONS=4000
SPARK_OUTPUT_PARTITIONS=512
SPARK_SUBMIT_OPTIONS=

# 可以替换为目标机器上的固定 Python 解释器绝对路径。
PYTHON_BIN=python
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
