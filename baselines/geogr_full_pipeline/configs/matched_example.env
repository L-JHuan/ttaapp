# 必填：仓库、数据、模型和全新输出目录的绝对路径
REPO_ROOT=/absolute/path/to/TAP-SID
PROCESSED_ROOT=/absolute/path/to/processed_dataset
RUN_ROOT=/absolute/path/to/new_geogr_run
BASE_MODEL=/absolute/path/to/Meta-Llama-3-8B-Instruct

# 数据集专属设置：NYC=32，TKY=64
DATASET=NYC
CODEBOOK_SIZE=32

# 两张 4090D；流水线会等待两卡同时空闲
GPUS=0,1
GPU_MEMORY_THRESHOLD_MIB=300
GPU_UTIL_THRESHOLD=5
WAIT_SECONDS=10

# 与主实验一致的公共训练协议
SFT_EPOCHS=3
SFT_GRAD_ACCUM=8
LEARNING_RATE=1e-5
SEED=42
KEEP_LAST_K_TRAIN=5
TEST_BEAMS=10

# GeoGR 专属步骤
P2P_BATCH_SIZE=4
P2P_GRAD_ACCUM=2
P2P_EPOCHS=3
P2P_MAX_PAIRS_PER_POI=50
EM_ITERATIONS=2
EM_EPOCHS=2
EM_BEAMS=20
CPT_EPOCHS=2
CPT_GRAD_ACCUM=8

# 当前服务器环境可直接指定解释器；默认使用 PATH 中 python
PYTHON_BIN=python
