# Reuse the exact chronological preprocessing output produced by TAP-SID.
PROCESSED_ROOT=./data/processed/example
RUN_ROOT=./outputs/geogr_example

BASE_MODEL=/path/to/Meta-Llama-3-8B-Instruct
NO_VALIDATION=0
KEEP_LAST_K_TRAIN=5

# GeoGR SID construction. The paper uses 32 for NYC and 64 for TKY.
GEOGR_CODEBOOK_SIZE=32
GEOGR_ENCODER_MODEL=/path/to/poi/text/encoder
GEOGR_ENCODER_DEVICE=cuda:0
GEOGR_ENCODER_BACKEND=sentence_transformers
GEOGR_ENCODER_DTYPE=auto
GEOGR_ENCODER_BATCH_SIZE=16
GEOGR_ENCODER_MAX_LENGTH=128
GEOGR_MAX_DISTANCE_KM=3.0
GEOGR_MIN_COMMON_USERS=2
GEOGR_SWING_ALPHA=1.0
GEOGR_MAX_PAIRS_PER_POI=50
GEOGR_CONTRASTIVE_DEVICE=cuda:0
GEOGR_CONTRASTIVE_EPOCHS=10
GEOGR_CONTRASTIVE_BATCH_SIZE=256
GEOGR_CONTRASTIVE_LEARNING_RATE=1e-4
GEOGR_CONTRASTIVE_TEMPERATURE=0.07
GEOGR_SEED=2024

# Matched LLM training and evaluation.
CUDA_VISIBLE_DEVICES=0,1
NPROC_PER_NODE=2
TRAIN_BATCH_SIZE=1
TRAIN_EVAL_BATCH_SIZE=1
TRAIN_GRAD_ACCUM=8
TRAIN_EPOCHS=3
TRAIN_LEARNING_RATE=1e-5
TRAIN_CUTOFF_LEN=2048
TRAIN_LORA_R=16
TRAIN_LORA_ALPHA=32
TRAIN_LORA_DROPOUT=0.1
TRAIN_SEED=42
TRAIN_LOGGING_STEPS=50

EVAL_GPUS=0,1
EVAL_NUM_BEAMS=10
EVAL_K=10
EVAL_SEED=42
