# Reuse the exact chronological preprocessing output produced by TAP-SID.
PROCESSED_ROOT=./data/processed/example
RUN_ROOT=./outputs/spacetime_gr_example

BASE_MODEL=/path/to/Meta-Llama-3-8B-Instruct
NO_VALIDATION=0
KEEP_LAST_K_TRAIN=5

# Paper-defined geographic hierarchy.
SPACETIME_BLOCK_SIZE_KM=5.0

# Matched LLM training and evaluation.
CUDA_VISIBLE_DEVICES=0,1
NPROC_PER_NODE=2
TRAIN_BATCH_SIZE=1
TRAIN_EVAL_BATCH_SIZE=1
TRAIN_GRAD_ACCUM=8
TRAIN_EPOCHS=3
TRAIN_LEARNING_RATE=1e-5
TRAIN_CUTOFF_LEN=2048
TRAIN_LORA_R=16
TRAIN_LORA_ALPHA=32
TRAIN_LORA_DROPOUT=0.1
TRAIN_SEED=42
TRAIN_LOGGING_STEPS=50

EVAL_GPUS=0,1
EVAL_NUM_BEAMS=10
EVAL_K=10
EVAL_SEED=42
