# 本文件由已成功运行的 TAP-SID 工业实验配置派生。
# 首次运行前，只替换路径和时间边界；数据协议、训练超参数与 TAP-SID 保持一致。

# 原始工业日志。即使复用预处理，检查脚本仍要求该变量存在。
INDUSTRIAL_JSONL=/path/to/data/output-*.jsonl
INDUSTRIAL_TIMEZONE_OFFSET_MINUTES=480

# 必须指向已完成 TAP-SID 实验使用的同一个预处理目录。
PROCESSED_ROOT=/path/to/workspace/tap_sid_processed
# Residual SID 使用独立输出目录，禁止与 TAP-SID 的 RUN_ROOT 相同。
RUN_ROOT=/path/to/workspace/residual_sid_run
REUSE_PREPROCESSED=1

# 与已完成的 TAP-SID local.env 保持完全一致。
TRAIN_END=REPLACE_WITH_TAP_TRAIN_END
VALIDATION_END=
NO_VALIDATION=1
DEFAULT_TIMEZONE_OFFSET_MINUTES=480
MAX_SEQUENCE_LENGTH=50
MIN_HISTORY_LENGTH=1
KEEP_LAST_K_TRAIN=5

# 使用与 TAP-SID 相同的基础模型。
BASE_MODEL=/path/to/Meta-Llama-3-8B-Instruct

# Residual SID 固定使用 all-MiniLM-L6-v2 构造类别文本表示；仅替换目录前缀。
CATEGORY_MODEL=/path/to/all-MiniLM-L6-v2
CATEGORY_DEVICE=cpu
CATEGORY_DIM=64
CODEBOOK_DEVICE=cuda:0
CODEBOOK_EPOCHS=3000
CODEBOOK_BATCH_SIZE=128
CODEBOOK_NUM_WORKERS=4
CODEBOOK_EVAL_STEP=10
CODEBOOK_MIN_SELECT_EPOCH=200

# 沿用上次成功运行 TAP-SID 的四卡设置；对方可按实际资源自行调整。
# 有效批量为 1 * 4 * 4 = 16。
CUDA_VISIBLE_DEVICES=0,1,2,3
NPROC_PER_NODE=4
DEVICE=cuda:0
TRAIN_BATCH_SIZE=1
TRAIN_EVAL_BATCH_SIZE=1
TRAIN_GRAD_ACCUM=4
TRAIN_EPOCHS=3
TRAIN_LEARNING_RATE=1e-5
TRAIN_CUTOFF_LEN=2048
TRAIN_LORA_R=16
TRAIN_LORA_ALPHA=32
TRAIN_LORA_DROPOUT=0.1
TRAIN_SEED=42
TRAIN_LOGGING_STEPS=50
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# 沿用上次成功运行 TAP-SID 的四路独立评估分片。
EVAL_GPUS=0,1,2,3
EVAL_CUTOFF_LEN=2048
EVAL_MAX_NEW_TOKENS=32
EVAL_NUM_BEAMS=10
EVAL_K=10
EVAL_SEED=42
EVAL_NO_CACHE=0

# 保持与上次 TAP-SID 工业预处理相同；复用预处理时不会重新扫描原始日志。
SPARK_SUBMIT_BIN=spark-submit
SPARK_MASTER=yarn
SPARK_DRIVER_MEMORY=16g
SPARK_SHUFFLE_PARTITIONS=4000
SPARK_OUTPUT_PARTITIONS=512
SPARK_MAPPING_PARTITIONS=512
SPARK_SUBMIT_OPTIONS=
