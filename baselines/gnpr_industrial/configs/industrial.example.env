# Raw input. For Spark this can also be a glob or distributed-storage path.
INDUSTRIAL_JSONL=../../data/raw/output.jsonl

# Point this to the exact TAP preprocessing root for a matched comparison.
PROCESSED_ROOT=../../data/processed/industrial_run
RUN_ROOT=../../outputs/gnpr_industrial_run
REUSE_PREPROCESSED=1

# 与已完成的 TAP-SID 实验使用相同的训练截止时间，不单独划分验证集。
# 使用时必须将 TRAIN_END 替换为 TAP-SID local.env 中的实际值。
TRAIN_END=REPLACE_WITH_TAP_TRAIN_END
VALIDATION_END=
NO_VALIDATION=1
DEFAULT_TIMEZONE_OFFSET_MINUTES=480
MAX_SEQUENCE_LENGTH=50
MIN_HISTORY_LENGTH=1
KEEP_LAST_K_TRAIN=5

# Local model directories.
BASE_MODEL=/path/to/Meta-Llama-3-8B-Instruct
CATEGORY_MODEL=/path/to/all-MiniLM-L6-v2

# GNPR continuous representation and residual codebook.
CATEGORY_DEVICE=cpu
CATEGORY_DIM=64
CODEBOOK_DEVICE=cuda:0
CODEBOOK_EPOCHS=3000
CODEBOOK_BATCH_SIZE=128
CODEBOOK_NUM_WORKERS=4
CODEBOOK_EVAL_STEP=10
CODEBOOK_MIN_SELECT_EPOCH=200

# LLM training. Effective batch size = batch * grad_accum * process count.
CUDA_VISIBLE_DEVICES=0,1
NPROC_PER_NODE=2
TRAIN_BATCH_SIZE=1
TRAIN_EVAL_BATCH_SIZE=1
TRAIN_GRAD_ACCUM=8
TRAIN_EPOCHS=3
TRAIN_LEARNING_RATE=1e-5
TRAIN_CUTOFF_LEN=2048
TRAIN_LORA_R=16
TRAIN_LORA_ALPHA=32
TRAIN_LORA_DROPOUT=0.1
TRAIN_SEED=42
TRAIN_LOGGING_STEPS=50

# Multi-GPU independent evaluation shards.
EVAL_GPUS=0,1
EVAL_CUTOFF_LEN=2048
EVAL_MAX_NEW_TOKENS=32
EVAL_NUM_BEAMS=10
EVAL_K=10
EVAL_SEED=42
EVAL_NO_CACHE=0

# Optional Spark settings for very large inputs.
SPARK_SUBMIT_BIN=spark-submit
SPARK_MASTER=
SPARK_DRIVER_MEMORY=8g
SPARK_SHUFFLE_PARTITIONS=2000
SPARK_OUTPUT_PARTITIONS=256
SPARK_MAPPING_PARTITIONS=256
SPARK_SUBMIT_OPTIONS=
