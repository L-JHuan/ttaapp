# Input mode A: one industrial behavior JSONL file.
INDUSTRIAL_JSONL=
INDUSTRIAL_TIMEZONE_OFFSET_MINUTES=480

# Input mode B: one raw TSMC2014-compatible eight-column TSV file.
TSMC_FILE=
TSMC_ENCODING=latin-1
TSMC_CATEGORY_L1_MAP=./configs/foursquare_category_l1_map.json

# Input mode C: prepared event and POI tables. Used when both raw-file inputs are empty.
EVENTS=./data/raw/events.csv
POIS=./data/raw/pois.csv
PROCESSED_ROOT=./data/processed/example
RUN_ROOT=./outputs/example

TRAIN_END=2025-01-01T00:00:00Z
VALIDATION_END=2025-02-01T00:00:00Z
DEFAULT_TIMEZONE_OFFSET_MINUTES=480

BASE_MODEL=/path/to/base/model
N_COARSE_REGIONS=64
N_FINE_REGIONS=256
NPROC_PER_NODE=1
DEVICE=cuda:0
