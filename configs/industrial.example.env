# One JSON object per line with:
# user_id, poiid, new_key_type, longitude, latitude, log_time
INDUSTRIAL_JSONL=./data/raw/output.jsonl
INDUSTRIAL_TIMEZONE_OFFSET_MINUTES=480

# Generated data and experiment artifacts.
PROCESSED_ROOT=./data/processed/industrial_run
RUN_ROOT=./outputs/industrial_run

# Inclusive UTC cutoffs. Replace them according to the actual data range.
# This example uses a 14-day train / 3-day validation / 3-day test split.
TRAIN_END=2026-07-14T15:59:59Z
VALIDATION_END=2026-07-17T15:59:59Z
NO_VALIDATION=0
DEFAULT_TIMEZONE_OFFSET_MINUTES=480

# Local Hugging Face model directory.
BASE_MODEL=/path/to/Meta-Llama-3-8B-Instruct

N_COARSE_REGIONS=64
N_FINE_REGIONS=256
MAX_SEQUENCE_LENGTH=50
MIN_HISTORY_LENGTH=1
KEEP_LAST_K_TRAIN=5

# Two-GPU training. batch_size * grad_accum * world_size = 16.
CUDA_VISIBLE_DEVICES=0,1
NPROC_PER_NODE=2
DEVICE=cuda:0
TRAIN_BATCH_SIZE=1
TRAIN_EVAL_BATCH_SIZE=1
TRAIN_GRAD_ACCUM=8
TRAIN_EPOCHS=3
TRAIN_LEARNING_RATE=1e-5
TRAIN_CUTOFF_LEN=2048
TRAIN_LORA_R=16
TRAIN_LORA_ALPHA=32
TRAIN_LORA_DROPOUT=0.1
TRAIN_SEED=42
TRAIN_LOGGING_STEPS=50

# Two independent evaluation shards.
EVAL_GPUS=0,1
EVAL_CUTOFF_LEN=2048
EVAL_MAX_NEW_TOKENS=32
EVAL_NUM_BEAMS=10
EVAL_K=10
EVAL_SEED=42
EVAL_NO_CACHE=0

# Optional Spark preprocessing for very large JSONL inputs.
# Use scripts/prepare_data_spark.sh instead of scripts/prepare_data.sh.
SPARK_SUBMIT_BIN=spark-submit
SPARK_MASTER=
SPARK_DRIVER_MEMORY=8g
SPARK_SHUFFLE_PARTITIONS=2000
SPARK_OUTPUT_PARTITIONS=256
SPARK_MAPPING_PARTITIONS=256
# Example for YARN or a standalone cluster:
# SPARK_SUBMIT_OPTIONS="--num-executors 20 --executor-cores 8 --executor-memory 24g"
SPARK_SUBMIT_OPTIONS=
