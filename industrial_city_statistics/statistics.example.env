# 复制为 statistics.local.env，再填入对方机器上实际存在的路径。
# 三个目录必须对应同一批已完成实验；不要填写模型 checkpoint 路径。
TAP_RUN_ROOT=
GNPR_RUN_ROOT=
PROCESSED_ROOT=

# 指定收到的 poi_info_字段清理.jsonl 在运行机器上的真实位置。
# 填写后通过 PROCESSED_ROOT 的已有映射关联原始 POI 编号与内部 pid。
# 留空时使用已有预处理坐标和仓库离线行政区边界，不读取原始行为日志。
POI_CITY_JSONL=

# 可选：解释器及输出根目录；不填写则分别使用 python 和仓库 outputs/city_statistics。
# CITY_STATS_ROOT 下每次新建时间戳目录，历史结果不会被覆盖。
PYTHON_BIN=python
CITY_STATS_ROOT=
